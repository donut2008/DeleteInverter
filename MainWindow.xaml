<Window x:Class="DeleteInverter.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:DeleteInverter"
		mc:Ignorable="d"
		Title="DeleteInverter" Height="700" Width="1000"
		ResizeMode="NoResize"
		xmlns:ui="http://schemas.modernwpf.com/2019"
		ui:WindowHelper.UseModernWindowStyle="True">
	<ui:SimpleStackPanel>
		<Grid Margin="8">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<TextBlock FontSize="32" VerticalAlignment="Center" Grid.Row="0">
				DeleteInverter
				</TextBlock>
				<StackPanel Orientation="Horizontal" Grid.Row="1"
						Margin="0,8,0,4">
					<TextBlock VerticalAlignment="Center"
						   Margin="0,0,4,0">
					Browse for folder:
					</TextBlock>
					<TextBox x:Name="DirPath"
						 IsReadOnly="True"
						 Margin="0,0,4,0"
						 VerticalAlignment="Center"
						 IsHitTestVisible="False"
						 IsTabStop="False"/>
					<Button x:Name="BrowseFolder"
						Click="BrowseFolder_Click"
						VerticalAlignment="Center">
						Browse for folder
					</Button>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Grid.Row="2"
						Margin="0,4">
					<TextBlock VerticalAlignment="Center"
						   Margin="0,0,4,0">
					Select file list:
					</TextBlock>
					<TextBox x:Name="ListPath"
						 IsReadOnly="True"
						 Margin="0,0,4,0"
						 VerticalAlignment="Center"
						 IsHitTestVisible="False"
						 IsTabStop="False"/>
					<Button x:Name="BrowseFileList"
						Click="BrowseFileList_Click"
						VerticalAlignment="Center">
						Browse for file list
					</Button>
				</StackPanel>
				<Button Margin="0,4" Grid.Row="3"
					Click="CheckBeforeDelete"
					x:Name="DeleteBtn"
						Style="{StaticResource AccentButtonStyle}">
					Delete files
				</Button>
				<TextBlock Grid.Row="4">Progress</TextBlock>
				<Border BorderBrush="Gray" BorderThickness="1"
					 Margin="0,4,0,0"
					Padding="4" Grid.Row="5">
					<ScrollViewer HorizontalScrollBarVisibility="Disabled"
						  VerticalScrollBarVisibility="Visible">
						<TextBlock x:Name="ProgressBox"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						   ScrollViewer.VerticalScrollBarVisibility="Visible"/>
					</ScrollViewer>
				</Border>
			</Grid>
			<Button Click="HelpClick"
					VerticalAlignment="Top"
					HorizontalAlignment="Right">
				Need help?
			</Button>
		</Grid>
		<ui:ContentDialog
			x:Name="HelpDialog"
					   Title="Help"
					   PrimaryButtonText="OK">
			<ui:ContentDialog.Content>
				<TextBlock TextWrapping="WrapWithOverflow">
					Select a folder in which to delete files using the "Browse for folder button".
					Select a file list containing the list of files which are <Run FontWeight="Bold">NOT</Run> to be deleted.
					An empty list works too, with the effect that the contents of the folder are deleted without the folder itself.
					<LineBreak/>
					Each file name should be in a separate line.
					<LineBreak/>
					FILE NAMES ARE CASE SENSITIVE! "myFile.txt" will NOT be recognised as "myfile.txt", "Myfile.txt", or as any other
					combinations!
					<LineBreak/>
					Why? Because I cannot implement case-insensitive file name checking.
				</TextBlock>
			</ui:ContentDialog.Content>
		</ui:ContentDialog>
		<ui:ContentDialog x:Name="DeleteAllFilesWarning"
					   Title="DELETE ALL FILES?"
					   PrimaryButtonClick="ConfirmAllFilesDeletion"
					   PrimaryButtonText="CONFIRM"
					   SecondaryButtonText="CANCEL">
			<ui:ContentDialog.Content>
				<TextBlock x:Name="WarnText" TextWrapping="WrapWithOverflow"/>
			</ui:ContentDialog.Content>
		</ui:ContentDialog>
		<ui:ContentDialog x:Name="NoFolder"
					   Title="No folder selected."
					   PrimaryButtonText="OK"/>
	</ui:SimpleStackPanel>
</Window>
